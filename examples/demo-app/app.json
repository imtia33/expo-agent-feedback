{
  "expo": {
    "name": "expo-eyes Demo",
    "slug": "expo-eyes-demo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "expoeyesdemo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "asyncRoutes": false
    }
  }
}
